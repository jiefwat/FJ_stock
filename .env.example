# Optional enrichment only. Core market data runs without this key.
IWENCAI_API_KEY=
# Optional financial LLM. Any OpenAI-compatible Chat Completions endpoint can be used.
MARKETDESK_FINANCIAL_LLM_API_KEY=
MARKETDESK_FINANCIAL_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MARKETDESK_FINANCIAL_LLM_MODEL=qwen3.7-plus
MARKETDESK_FINANCIAL_LLM_API_STYLE=chat_completions
# Keep false for context-only answers; enable only when the selected provider supports search.
MARKETDESK_FINANCIAL_LLM_WEB_SEARCH_ENABLED=false
MARKETDESK_DATA_DIR=data
PORT=8765
# Optional morning email sender. Never commit real secrets.
MARKETDESK_MORNING_EMAIL_BASE_URL=https://stock.jiewat-kaka-fj.com
MARKETDESK_EMAIL_SENDER=
MARKETDESK_EMAIL_FROM=
MARKETDESK_EMAIL_SENDER_NAME=StockTS 股票分析助手
MARKETDESK_EMAIL_PASSWORD=
MARKETDESK_EMAIL_RECEIVERS=
MARKETDESK_SMTP_HOST=
MARKETDESK_SMTP_PORT=0
MARKETDESK_SMTP_TLS=auto
